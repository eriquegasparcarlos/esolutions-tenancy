{
    "name": "esolutions/tenancy",
    "description": "Single-database multi-tenancy for Laravel: fail-closed row-level isolation, domain resolution and session scoping",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Carlos Erique Gaspar",
            "email": "eriquegasparcarlos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "league/flysystem-path-prefixing": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Esolutions\\Tenancy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esolutions\\Tenancy\\TenancyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
